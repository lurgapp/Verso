# Copy to .env on the server; generate new independent secrets.
PUBLIC_BASE_URL=https://verso.example.com
LURG_URL=https://lurg.pro
POSTGRES_USER=verso
POSTGRES_DB=verso
POSTGRES_PASSWORD=replace-with-random-hex-secret
DATABASE_URL=postgresql://verso:replace-with-random-hex-secret@verso-database:5432/verso?schema=public&connection_limit=8&pool_timeout=10
RATE_LIMIT_SECRET=replace-with-independent-random-hex-secret
S3_ENDPOINT=http://verso-storage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GKreplace-with-32-hex-characters
S3_SECRET_ACCESS_KEY=replace-with-independent-random-hex-secret
S3_BUCKET=verso-media
# Generate a fresh value with: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Only needed for Docker Compose standalone Caddy deployment.
DOMAIN=verso.example.com
ACME_EMAIL=

# Existing reverse proxy network, when using compose.production.yml.
VERSO_INGRESS_NETWORK=verso-ingress
